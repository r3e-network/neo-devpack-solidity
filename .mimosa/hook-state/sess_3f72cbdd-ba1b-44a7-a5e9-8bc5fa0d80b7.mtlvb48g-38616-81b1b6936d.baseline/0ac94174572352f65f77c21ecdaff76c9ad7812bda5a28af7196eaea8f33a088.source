{
  "name": "@neo-devpack-solidity/cli-tools",
  "version": "0.14.1",
  "description": "Command-line tools for Neo DevPack for Solidity development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "solc-neo": "./dist/solc-neo.js",
    "neo-sol": "./dist/neo-sol.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./solc-neo": {
      "import": "./dist/solc-neo.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "neo",
    "solidity",
    "compiler",
    "cli",
    "blockchain",
    "neovm"
  ],
  "dependencies": {
    "@neo-devpack-solidity/types": "^0.14.1",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.0",
    "fs-extra": "^11.3.4",
    "glob": "^10.5.0",
    "debug": "^4.3.4",
    "semver": "^7.7.4",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/fs-extra": "^11.0.4",
    "@types/debug": "^4.1.12",
    "@types/inquirer": "^9.0.7",
    "@types/yargs": "^17.0.35",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "eslint": "^8.57.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
