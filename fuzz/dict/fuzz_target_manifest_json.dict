# Neo manifest JSON parser dictionary
# Top-level keys
"\"name\""
"\"abi\""
"\"groups\""
"\"features\""
"\"supportedstandards\""
"\"permissions\""
"\"trusts\""
"\"extra\""
# ABI sub-keys
"\"methods\""
"\"events\""
"\"parameters\""
"\"returntype\""
"\"offset\""
"\"safe\""
# Method/event sub-keys
"\"type\""
"\"contract\""
"\"methods\""
# Parameter type names
"\"Integer\""
"\"ByteArray\""
"\"Hash160\""
"\"Hash256\""
"\"String\""
"\"Boolean\""
"\"Array\""
"\"Map\""
"\"InteropInterface\""
"\"Any\""
"\"Void\""
"\"Signature\""
"\"PublicKey\""
"\"Buffer\""
"\"Pointer\""
"\"Null\""
# Common standard names
"\"NEP-17\""
"\"NEP-11\""
"\"NEP-24\""
"\"NEP-27\""
# JSON structural literals
"true"
"false"
"null"
"[]"
"{}"
"\"*\""
# Common JSON number tokens
"0x"
"0x00"
"0xffffffff"
